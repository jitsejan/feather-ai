# Confluence API credentials
# Get your API token at: https://id.atlassian.com/manage-profile/security/api-tokens
[sources.atlassian_confluence]
username = "your.email@example.com"
password = "YOUR_ATLASSIAN_API_TOKEN"

# Local DuckDB connection — filename is derived from the space key in config.toml (e.g. "int.duckdb")
# For MotherDuck (cloud), use: "md:database_name?token=your-motherduck-token"
[destination.duckdb]
credentials = "int.duckdb"
